{
    "name": "opsfour/s3-server",
    "description": "Production-grade S3-compatible server as a PHP 8.4+ Composer package",
    "type": "library",
    "license": "MIT",
    "homepage": "https://twopeaks.digital",
    "support": {
        "source": "https://ops4.com",
        "issues": "https://ops4.com"
    },
    "require": {
        "php": "^8.4",
        "amphp/amp": "^3.1.2",
        "amphp/http-client": "^5.3",
        "amphp/http-server": "^3.4",
        "amphp/http-server-router": "^2.0",
        "amphp/file": "^3.2",
        "amphp/byte-stream": "^2.0",
        "amphp/mysql": "^3.0",
        "amphp/postgres": "^2.1",
        "amphp/parallel": "^2.3",
        "amphp/sync": "^2.3",
        "amphp/log": "^2.0",
        "amphp/dns": "^2.4",
        "monolog/monolog": "^3.0",
        "amphp/pipeline": "^1.0",
        "revolt/event-loop": "^1.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.4 || ^8.1",
        "league/flysystem": "^3.0",
        "amphp/http-server-form-parser": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "amphp/redis": "^2.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/framework": "^12.0 || ^13.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "aws/aws-sdk-php": "^3.384.9",
        "guzzlehttp/guzzle": "^7.11.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "OpsFour\\S3Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpsFour\\S3Server\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php --using-cache=no --sequential",
        "cs:check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff --using-cache=no --sequential",
        "quality": [
            "@analyse",
            "@cs:check",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "symfony/http-kernel": "Required when using OpsFour S3 Server as a Symfony Bundle.",
        "amphp/redis": "Required when using the Redis master-key provider.",
        "aws/aws-sdk-php": "Required for the S3-compatible Flysystem worker factory.",
        "league/flysystem-aws-s3-v3": "Required for the S3-compatible Flysystem worker factory."
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpsFour\\S3Server\\Laravel\\S3ServerServiceProvider"
            ]
        }
    }
}
