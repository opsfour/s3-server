{
    "name": "opsfour/s3-server",
    "description": "Production-grade S3-compatible server as a PHP 8.4+ Composer package",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "amphp/http-client": "^5.0",
        "amphp/http-server": "^3.4",
        "amphp/http-server-router": "^2.0",
        "amphp/file": "^3.2",
        "amphp/byte-stream": "^2.0",
        "amphp/mysql": "^3.0",
        "amphp/postgres": "^2.1",
        "amphp/parallel": "^2.3",
        "amphp/log": "^2.0",
        "amphp/dns": "^2.0",
        "monolog/monolog": "^3.0",
        "amphp/pipeline": "^1.0",
        "revolt/event-loop": "^1.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.0",
        "league/flysystem": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "aws/aws-sdk-php": "^3.300",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "OpsFour\\S3Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpsFour\\S3Server\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "OpsFour\\S3Server\\Laravel\\S3ServerServiceProvider"
            ]
        }
    }
}
