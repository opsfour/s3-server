parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    scanFiles:
        - phpstan-laravel-stubs.php
        - scripts/lib/MultihostNodeBootstrap.php
    stubFiles:
        # Cancellation can change while a fiber is suspended by I/O.
        - phpstan-amp-cancellation.stub
    paths:
        - src
        - tests
        - scripts/cleanup-production-soak.php
        - scripts/lib/MultihostNodeBootstrap.php
