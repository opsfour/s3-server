#!/bin/sh

set -eu

PACKAGE_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
COMPOSE_FILE="$PACKAGE_DIR/docker/production-soak/compose.yml"
SOAK_DOCKERFILE="$PACKAGE_DIR/docker/production-soak/Dockerfile"
STATE_DIR=${S3_SOAK_STATE_DIR:-/var/tmp/opsfour-s3-production-soak}
RUNTIME_FILE="$STATE_DIR/runtime.env"
RESULT_FILE="$STATE_DIR/result"
PROJECT_NAME=opsfour-s3-production-soak

fail()
{
    printf '%s\n' "$1" >&2
    exit 1
}

validate_state_dir()
{
    case "$STATE_DIR" in
        /*) ;;
        *) fail 'S3_SOAK_STATE_DIR must be an absolute path.' ;;
    esac
    case "$STATE_DIR" in
        *[!A-Za-z0-9_./-]*) fail 'S3_SOAK_STATE_DIR contains unsupported characters.' ;;
    esac
    case "$STATE_DIR/" in
        *'/../'*|*'/./'*) fail 'S3_SOAK_STATE_DIR must not contain parent or current-directory segments.' ;;
    esac
    [ "$STATE_DIR" = "${STATE_DIR%/}" ] || fail 'S3_SOAK_STATE_DIR must not end with a slash.'
    [ "$STATE_DIR" != / ] || fail 'S3_SOAK_STATE_DIR must not be the filesystem root.'
    case "$STATE_DIR/" in
        "$PACKAGE_DIR"/*) fail 'S3_SOAK_STATE_DIR must be outside the package checkout.' ;;
    esac
}

validate_existing_state_dir()
{
    [ -d "$STATE_DIR" ] || fail 'S3_SOAK_STATE_DIR does not exist or is not a directory.'
    [ ! -L "$STATE_DIR" ] || fail 'S3_SOAK_STATE_DIR must not be a symbolic link.'
    resolved_state_dir=$(CDPATH='' cd -- "$STATE_DIR" && pwd -P)
    [ "$resolved_state_dir" = "$STATE_DIR" ] \
        || fail 'S3_SOAK_STATE_DIR must not traverse symbolic links.'
}

prepare_state_dir()
{
    state_parent=${STATE_DIR%/*}
    [ -n "$state_parent" ] || state_parent=/
    [ -d "$state_parent" ] || fail 'The parent of S3_SOAK_STATE_DIR must already exist.'
    [ ! -L "$state_parent" ] || fail 'The parent of S3_SOAK_STATE_DIR must not be a symbolic link.'
    resolved_state_parent=$(CDPATH='' cd -- "$state_parent" && pwd -P)
    [ "$resolved_state_parent" = "$state_parent" ] \
        || fail 'The parent of S3_SOAK_STATE_DIR must not traverse symbolic links.'

    if [ -e "$STATE_DIR" ]; then
        validate_existing_state_dir
    else
        mkdir -- "$STATE_DIR"
        validate_existing_state_dir
    fi
    if find "$STATE_DIR" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; then
        fail 'S3_SOAK_STATE_DIR must be empty before a new run.'
    fi
}

validate_data_dir()
{
    case "$S3_SOAK_DATA_DIR" in
        "$STATE_DIR"/data/*) ;;
        *) fail 'Production soak data is outside its state directory.' ;;
    esac
    [ -d "$S3_SOAK_DATA_DIR" ] || fail 'Production soak data directory is missing.'
    resolved_data_dir=$(CDPATH='' cd -- "$S3_SOAK_DATA_DIR" && pwd -P)
    [ "$resolved_data_dir" = "$S3_SOAK_DATA_DIR" ] \
        || fail 'Production soak data must not traverse symbolic links.'
}

validate_backend()
{
    case "$S3_SOAK_METADATA_DRIVER" in
        sqlite|postgres|mysql) ;;
        *) fail 'S3_SOAK_METADATA_DRIVER must be sqlite, postgres, or mysql.' ;;
    esac
}

validate_image()
{
    [ "${#S3_SOAK_IMAGE}" -le 255 ] \
        || fail 'S3_SOAK_IMAGE must not exceed 255 characters.'
    case "$S3_SOAK_IMAGE" in
        ''|*[!A-Za-z0-9._:/-]*)
            fail 'S3_SOAK_IMAGE contains unsupported characters.'
            ;;
        [!A-Za-z0-9]*|*//*|*/|*:)
            fail 'S3_SOAK_IMAGE is not a safe Docker image reference.'
            ;;
    esac
}

configure_image()
{
    if [ -z "${S3_SOAK_IMAGE:-}" ]; then
        if command -v sha256sum >/dev/null 2>&1; then
            dockerfile_hash=$(sha256sum "$SOAK_DOCKERFILE" | awk '{print $1}')
        elif command -v shasum >/dev/null 2>&1; then
            dockerfile_hash=$(shasum -a 256 "$SOAK_DOCKERFILE" | awk '{print $1}')
        else
            fail 'sha256sum or shasum is required to derive the production-soak image tag.'
        fi
        case "$dockerfile_hash" in
            *[!0-9a-f]*|'') fail 'Could not derive the production-soak Dockerfile SHA-256.' ;;
        esac
        [ "${#dockerfile_hash}" -eq 64 ] \
            || fail 'Could not derive the production-soak Dockerfile SHA-256.'
        S3_SOAK_IMAGE="opsfour-s3-production-soak:$dockerfile_hash"
    fi
    validate_image
    export S3_SOAK_IMAGE
}

require_local_image()
{
    if ! docker image inspect "$S3_SOAK_IMAGE" >/dev/null 2>&1; then
        message="Production-soak image $S3_SOAK_IMAGE is not available locally."
        fail "$message Build it once or load it from a trusted cache before starting the runner."
    fi
}

configure_metadata_dsn()
{
    case "$S3_SOAK_METADATA_DRIVER" in
        sqlite) S3_SOAK_METADATA_DSN='' ;;
        postgres) S3_SOAK_METADATA_DSN='host=postgres port=5432 dbname=s3server user=s3 password=s3audit' ;;
        mysql) S3_SOAK_METADATA_DSN='host=mysql;port=3306;dbname=s3server;user=s3;password=s3audit' ;;
    esac
    export S3_SOAK_METADATA_DSN
}

compose()
{
    case "$S3_SOAK_METADATA_DRIVER" in
        postgres|mysql)
            docker compose --project-name "$PROJECT_NAME" --file "$COMPOSE_FILE" \
                --profile "$S3_SOAK_METADATA_DRIVER" "$@"
            ;;
        *)
            docker compose --project-name "$PROJECT_NAME" --file "$COMPOSE_FILE" "$@"
            ;;
    esac
}

load_runtime()
{
    validate_state_dir
    validate_existing_state_dir
    if [ ! -f "$RUNTIME_FILE" ]; then
        fail 'No production soak runtime state exists.'
    fi

    set -a
    # shellcheck disable=SC1090
    . "$RUNTIME_FILE"
    set +a
    export S3_SOAK_STATE_DIR="$STATE_DIR"
    configure_image
    validate_backend
    configure_metadata_dsn
}

preserve_diagnostics()
{
    container_id=$(compose ps --all --quiet soak 2>/dev/null || true)
    if [ -n "$container_id" ]; then
        docker inspect --format \
            'container={{.State.Status}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}} started={{.State.StartedAt}} finished={{.State.FinishedAt}}' \
            "$container_id" > "$STATE_DIR/container-status" 2>/dev/null || true
        compose logs --no-color soak > "$STATE_DIR/soak.log" 2>&1 || true
    fi
    if [ "$S3_SOAK_METADATA_DRIVER" != sqlite ]; then
        backend_container_id=$(compose ps --all --quiet "$S3_SOAK_METADATA_DRIVER" 2>/dev/null || true)
        if [ -n "$backend_container_id" ]; then
            docker inspect --format \
                'container={{.State.Status}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}} health={{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} started={{.State.StartedAt}} finished={{.State.FinishedAt}}' \
                "$backend_container_id" > "$STATE_DIR/$S3_SOAK_METADATA_DRIVER-container-status" 2>/dev/null || true
            compose logs --no-color "$S3_SOAK_METADATA_DRIVER" \
                > "$STATE_DIR/$S3_SOAK_METADATA_DRIVER.log" 2>&1 || true
        fi
    fi
}

write_aborted_result()
{
    [ -f "$RESULT_FILE" ] && return

    finished_epoch=$(date -u '+%s')
    elapsed=$((finished_epoch - S3_SOAK_STARTED_EPOCH))
    temporary="$RESULT_FILE.tmp"
    printf 'status=aborted\nexit=143\nqualification=%s\ncommit=%s\nmetadata=%s\nrequested_duration_seconds=%s\nstarted=%s\nfinished=%s\nelapsed_seconds=%s\n' \
        "$S3_SOAK_QUALIFICATION" \
        "$S3_SOAK_COMMIT" \
        "$S3_SOAK_METADATA_DRIVER" \
        "$S3_SOAK_DURATION_SECONDS" \
        "$S3_SOAK_STARTED_AT" \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        "$elapsed" > "$temporary"
    mv "$temporary" "$RESULT_FILE"
}

start_soak()
{
    [ "$(uname -s)" = Linux ] || fail 'The production soak release gate requires Linux.'
    [ "$(id -u)" -ne 0 ] || fail 'Run the production soak as a non-root Linux user with Docker access.'
    validate_state_dir

    S3_SOAK_METADATA_DRIVER=${S3_SOAK_METADATA_DRIVER:-sqlite}
    validate_backend
    configure_image
    S3_SOAK_DURATION_SECONDS=${S3_SOAK_DURATION_SECONDS:-43200}
    case "$S3_SOAK_DURATION_SECONDS" in
        ''|*[!0-9]*) fail 'S3_SOAK_DURATION_SECONDS must be a positive integer.' ;;
    esac
    [ "$S3_SOAK_DURATION_SECONDS" -gt 0 ] || fail 'S3_SOAK_DURATION_SECONDS must be greater than zero.'
    if [ "$S3_SOAK_DURATION_SECONDS" -ge 43200 ]; then
        S3_SOAK_QUALIFICATION=release
    else
        S3_SOAK_QUALIFICATION=smoke
    fi
    [ -f "$PACKAGE_DIR/vendor/autoload.php" ] || fail 'Run composer install before starting the production soak.'
    [ -z "$(git -C "$PACKAGE_DIR" status --porcelain --untracked-files=normal)" ] \
        || fail 'The production soak requires a clean package checkout.'
    require_local_image

    if docker ps --all \
        --filter "label=com.docker.compose.project=$PROJECT_NAME" \
        --quiet | grep -q .; then
        fail 'A production soak stack already exists; inspect and clean it before starting another.'
    fi
    if docker volume ls \
        --filter "label=com.docker.compose.project=$PROJECT_NAME" \
        --quiet | grep -q .; then
        fail 'Production soak database volumes already exist; inspect and remove the stale stack before starting.'
    fi
    if docker network ls \
        --filter "label=com.docker.compose.project=$PROJECT_NAME" \
        --quiet | grep -q .; then
        fail 'A production soak network already exists; inspect and remove the stale stack before starting.'
    fi
    umask 077
    prepare_state_dir
    S3_SOAK_RUN_ID="$(git -C "$PACKAGE_DIR" rev-parse --short HEAD)-$(date -u '+%Y%m%dT%H%M%SZ')"
    S3_SOAK_DATA_DIR="$STATE_DIR/data/$S3_SOAK_RUN_ID"
    mkdir -p "$S3_SOAK_DATA_DIR/objects" "$S3_SOAK_DATA_DIR/metadata"
    validate_data_dir
    chmod 0700 "$STATE_DIR" "$S3_SOAK_DATA_DIR" \
        "$S3_SOAK_DATA_DIR/objects" "$S3_SOAK_DATA_DIR/metadata"

    S3_SOAK_COMMIT=$(git -C "$PACKAGE_DIR" rev-parse HEAD)
    S3_SOAK_STARTED_AT=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    S3_SOAK_STARTED_EPOCH=$(date -u '+%s')
    S3_SOAK_HOST_UID=$(id -u)
    S3_SOAK_HOST_GID=$(id -g)
    configure_metadata_dsn
    export S3_SOAK_COMMIT S3_SOAK_DATA_DIR S3_SOAK_DURATION_SECONDS
    export S3_SOAK_HOST_GID S3_SOAK_HOST_UID S3_SOAK_IMAGE
    export S3_SOAK_METADATA_DRIVER S3_SOAK_METADATA_DSN
    export S3_SOAK_QUALIFICATION
    export S3_SOAK_STARTED_AT S3_SOAK_STARTED_EPOCH S3_SOAK_STATE_DIR="$STATE_DIR"

    printf 'S3_SOAK_RUN_ID=%s\nS3_SOAK_DURATION_SECONDS=%s\nS3_SOAK_QUALIFICATION=%s\nS3_SOAK_COMMIT=%s\nS3_SOAK_STARTED_AT=%s\nS3_SOAK_STARTED_EPOCH=%s\nS3_SOAK_METADATA_DRIVER=%s\nS3_SOAK_IMAGE=%s\nS3_SOAK_DATA_DIR=%s\nS3_SOAK_HOST_UID=%s\nS3_SOAK_HOST_GID=%s\n' \
        "$S3_SOAK_RUN_ID" \
        "$S3_SOAK_DURATION_SECONDS" \
        "$S3_SOAK_QUALIFICATION" \
        "$S3_SOAK_COMMIT" \
        "$S3_SOAK_STARTED_AT" \
        "$S3_SOAK_STARTED_EPOCH" \
        "$S3_SOAK_METADATA_DRIVER" \
        "$S3_SOAK_IMAGE" \
        "$S3_SOAK_DATA_DIR" \
        "$S3_SOAK_HOST_UID" \
        "$S3_SOAK_HOST_GID" > "$RUNTIME_FILE"

    if [ "$S3_SOAK_METADATA_DRIVER" != sqlite ]; then
        compose up --detach --wait --wait-timeout 90 "$S3_SOAK_METADATA_DRIVER"
        compose run --rm --no-deps soak php bin/s3-server metadata:migrate
    fi
    compose up --detach soak

    sleep 1
    container_id=$(compose ps --all --quiet soak)
    [ -n "$container_id" ] || fail 'The production soak container was not created.'
    running=$(docker inspect --format '{{.State.Running}}' "$container_id")
    if [ "$running" != true ]; then
        preserve_diagnostics
        fail "The production soak container exited during startup; inspect $STATE_DIR."
    fi

    printf 'Production soak started: duration=%ss qualification=%s metadata=%s state=%s\n' \
        "$S3_SOAK_DURATION_SECONDS" "$S3_SOAK_QUALIFICATION" \
        "$S3_SOAK_METADATA_DRIVER" "$STATE_DIR"
}

show_status()
{
    load_runtime
    preserve_diagnostics
    source_ok=true
    current_commit=$(git -C "$PACKAGE_DIR" rev-parse HEAD)
    if [ "$current_commit" != "$S3_SOAK_COMMIT" ] \
        || [ -n "$(git -C "$PACKAGE_DIR" status --porcelain --untracked-files=normal)" ]; then
        source_ok=false
        printf 'source=changed\n'
    else
        printf 'source=unchanged\n'
    fi

    container_id=$(compose ps --all --quiet soak 2>/dev/null || true)
    if [ -n "$container_id" ]; then
        cat "$STATE_DIR/container-status"
        running=$(docker inspect --format '{{.State.Running}}' "$container_id")
        exit_code=$(docker inspect --format '{{.State.ExitCode}}' "$container_id")
        oom=$(docker inspect --format '{{.State.OOMKilled}}' "$container_id")
    else
        if [ -f "$STATE_DIR/container-status" ]; then
            saved_container_status=$(cat "$STATE_DIR/container-status")
            printf '%s\n' "$saved_container_status"
            case " $saved_container_status " in
                *' exit=0 '*) exit_code=0 ;;
                *) exit_code=1 ;;
            esac
            case " $saved_container_status " in
                *' oom=false '*) oom=false ;;
                *) oom=true ;;
            esac
        else
            printf 'container=missing\n'
            exit_code=1
            oom=false
        fi
        running=false
    fi

    if [ -f "$RESULT_FILE" ]; then
        cat "$RESULT_FILE"
    fi
    tail -n 20 "$STATE_DIR/soak.log" 2>/dev/null || true

    backend_ok=true
    if [ "$S3_SOAK_METADATA_DRIVER" != sqlite ]; then
        backend_status_file="$STATE_DIR/$S3_SOAK_METADATA_DRIVER-container-status"
        if [ -f "$backend_status_file" ]; then
            saved_backend_status=$(cat "$backend_status_file")
            printf 'metadata_%s_%s\n' "$S3_SOAK_METADATA_DRIVER" "$saved_backend_status"
            case " $saved_backend_status " in
                *' container=running '*' oom=false '*' health=healthy '*) ;;
                *) backend_ok=false ;;
            esac
        else
            printf 'metadata_%s_container=missing\n' "$S3_SOAK_METADATA_DRIVER"
            backend_ok=false
        fi
    fi

    result_ok=false
    if grep -qx 'status=passed' "$RESULT_FILE" 2>/dev/null \
        && grep -qx "commit=$S3_SOAK_COMMIT" "$RESULT_FILE" \
        && grep -qx "qualification=$S3_SOAK_QUALIFICATION" "$RESULT_FILE" \
        && grep -qx "requested_duration_seconds=$S3_SOAK_DURATION_SECONDS" "$RESULT_FILE"; then
        result_elapsed=$(sed -n 's/^elapsed_seconds=//p' "$RESULT_FILE")
        case "$result_elapsed" in
            ''|*[!0-9]*) ;;
            *)
                if [ "$result_elapsed" -ge "$S3_SOAK_DURATION_SECONDS" ]; then
                    result_ok=true
                fi
                ;;
        esac
    fi

    if [ "$running" = true ] && [ "$source_ok" = true ] && [ "$backend_ok" = true ]; then
        return 0
    fi
    if [ "$source_ok" = true ] && [ "$backend_ok" = true ] \
        && [ "$oom" = false ] && [ "$exit_code" -eq 0 ] \
        && [ "$result_ok" = true ]; then
        return 0
    fi

    return 1
}

stop_soak()
{
    load_runtime
    preserve_diagnostics
    compose stop --timeout 60
    write_aborted_result
    preserve_diagnostics
    printf 'Production soak stopped; diagnostics and data remain in %s.\n' "$STATE_DIR"
}

cleanup_soak()
{
    load_runtime
    preserve_diagnostics
    container_id=$(compose ps --all --quiet soak 2>/dev/null || true)
    if [ -n "$container_id" ] \
        && [ "$(docker inspect --format '{{.State.Running}}' "$container_id")" = true ]; then
        fail 'The production soak is still running; stop it before cleanup.'
    fi
    compose down --volumes --remove-orphans
    validate_data_dir
    rm -rf -- "$S3_SOAK_DATA_DIR"
    printf 'Production soak containers, database volumes, and disposable data removed; evidence remains in %s.\n' \
        "$STATE_DIR"
}

case "${1:-}" in
    start) start_soak ;;
    status) show_status ;;
    stop) stop_soak ;;
    cleanup) cleanup_soak ;;
    *)
        printf 'Usage: %s start|status|stop|cleanup\n' "$0" >&2
        exit 2
        ;;
esac
