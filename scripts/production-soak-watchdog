#!/bin/sh

set -eu

delay=$((S3_TEST_PRODUCTION_SOAK_SECONDS + 600))
stopping=false
sleep "$delay" &
sleep_pid=$!
trap 'stopping=true; kill "$sleep_pid" 2>/dev/null || true' TERM INT

wait_status=0
wait "$sleep_pid" || wait_status=$?
if [ "$stopping" = true ]; then
    exit 0
fi
if [ "$wait_status" -ne 0 ]; then
    exit "$wait_status"
fi

status=0
php scripts/cleanup-production-soak.php || status=$?
printf 'exit=%d finished=%s\n' \
    "$status" \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > /soak-state/watchdog-result

exit "$status"
