#!/usr/bin/env php
<?php

declare(strict_types=1);

// Composer binary proxies expose the consuming project's autoloader here.
$proxyAutoloadPath = $GLOBALS['_composer_autoload_path'] ?? null;
$autoloadPaths = [
    is_string($proxyAutoloadPath) ? $proxyAutoloadPath : null,
    __DIR__ . '/../vendor/autoload.php',           // Standalone package install.
    __DIR__ . '/../../../autoload.php',             // Installed Composer dependency.
    __DIR__ . '/../../../vendor/autoload.php',      // Monorepo (packages/s3-server/bin/).
];

$autoloaderFound = false;
foreach ($autoloadPaths as $autoloadPath) {
    if ($autoloadPath !== null && is_file($autoloadPath)) {
        require $autoloadPath;
        $autoloaderFound = true;
        break;
    }
}

if (!$autoloaderFound) {
    fwrite(STDERR, "Error: Could not find Composer autoloader.\n");
    fwrite(STDERR, "Run 'composer install' in the package or project root.\n");
    exit(1);
}

use OpsFour\S3Server\Console\CredentialsCommand;
use OpsFour\S3Server\Console\CredentialsMigrateCommand;
use OpsFour\S3Server\Console\MetadataMigrateCommand;
use OpsFour\S3Server\Console\MultipartPartIntentCommand;
use OpsFour\S3Server\Console\QuotaCommand;
use OpsFour\S3Server\Console\ServeCommand;
use OpsFour\S3Server\Console\StorageAuditCommand;
use Composer\InstalledVersions;
use Symfony\Component\Console\Application;

$version = InstalledVersions::isInstalled('opsfour/s3-server')
    ? (InstalledVersions::getPrettyVersion('opsfour/s3-server') ?? 'unknown')
    : 'unknown';
$app = new Application('opsfour S3 Server', $version);
$app->addCommand(new ServeCommand());
$app->addCommand(new MetadataMigrateCommand());
$app->addCommand(new CredentialsCommand());
$app->addCommand(new CredentialsMigrateCommand());
$app->addCommand(new MultipartPartIntentCommand());
$app->addCommand(new QuotaCommand());
$app->addCommand(new StorageAuditCommand());
$app->setDefaultCommand('serve');
$app->run();
